# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# ── Secrets / machine config — NEVER commit ────────────
# config.json holds the live Trello API key + local machine paths.
# state.json holds persistence (pins, resolved-issues, franchise tags).
config.json
state.json
# ...but the bulletin watcher's config is site URLs + carrier names,
# not secrets — its credentials live in %LOCALAPPDATA%.
!bulletin_watch/config.json
.credentials*
*.env

# ── Customer data / PII — NEVER commit ─────────────────
EMS_Audit_Log.md
EMS_Audit_Backlog.md
audit_backlog.json
*.xlsx
*.xlsm
*.docx
*.pdf
*.db
*.sqlite*
*_undo.jsonl

# ── Logs ───────────────────────────────────────────────
logs/
*.log

# ── Caches / generated ─────────────────────────────────
paste-cache/
*.tmp
*.bak

# ── OS / OneDrive cruft ────────────────────────────────
desktop.ini
Thumbs.db
.DS_Store

# ── Build work dirs / tooling ──────────────────────────
build_qi/
build_*.txt
.claude/
.agents/
skills-lock.json

# Build output — the shipped folder is 108 MB and is rebuilt from the spec.
/dist/
/build/

# Side-path builds used when the app is running and holds dist/
dist_next/
build_next/
dist_release/
build_release/
/dist_[0-9]*/
/build_[0-9]*/
/dist_trial*/
/build_trial*/
/installer_trial*/
/dist_main*/
/build_main*/
/installer_main*/
/work/

# Inno Setup compiler output — installers are release artifacts, not source
Output/
